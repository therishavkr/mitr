RewriteEngine On
Options -Indexes

# Block VCS, dependencies, secrets, and tooling from public access
RewriteRule (^|/)\.git - [F,L]
RewriteRule (^|/)node_modules(/|$) - [F,L]
RewriteRule (^|/)tools(/|$) - [F,L]
RewriteRule (^|/)\.claude(/|$) - [F,L]
RewriteRule (^|/)\.vscode(/|$) - [F,L]
RewriteRule (^|/)\.env - [F,L]

# Forms post here. Keep /api/submit.php working even if that folder is missing.
RewriteRule ^api/submit\.php$ submit.php [L]

<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(package(-lock)?\.json|vite\.config\.js|vercel\.json|IMPROVEMENTS\.md|faculty_simple\.txt)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://dost.iitm.ac.in; frame-src 'self' https://maps.google.com https://www.google.com; connect-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src 'self' blob: https://cdn.jsdelivr.net; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>
